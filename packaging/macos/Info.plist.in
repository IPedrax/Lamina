<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- packaging/macos/package.sh substitutes @VERSION@ (in full, 0.5.0-rc.1 say), @SHORT_VERSION@ (the numbers, 0.5.0) and
     @BUILD_SHA@. Lifted from BIMCraft's (same author, MIT OR Apache-2.0). -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Lamina</string>
  <key>CFBundleName</key>
  <string>Lamina</string>
  <key>CFBundleExecutable</key>
  <string>Lamina</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.ipedrax.lamina</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>LaminaVersion</key>
  <string>@VERSION@</string>
  <key>LaminaBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>Lamina</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.graphics-design</string>
  <!-- As MACOSX_DEPLOYMENT_TARGET in package.sh: Big Sur, the first macOS on Apple silicon. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © 2026 IPedrax and the Lamina contributors. MIT.</string>

  <!-- A project is Lamina's own type, a .lamina holding JSON. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>io.github.ipedrax.lamina.project</string>
      <key>UTTypeDescription</key>
      <string>Lamina project</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.json</string></array>
      <key>UTTypeIconFile</key>
      <string>Lamina</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>lamina</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-lamina</string></array>
      </dict>
    </dict>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Lamina project</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array><string>io.github.ipedrax.lamina.project</string></array>
      <key>CFBundleTypeIconFile</key>
      <string>Lamina</string>
    </dict>
    <!-- Offered under Open With, never taking meshes from another app. -->
    <dict>
      <key>CFBundleTypeName</key>
      <string>3D model</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array><string>stl</string><string>3mf</string><string>obj</string><string>gltf</string><string>glb</string></array>
    </dict>
  </array>
</dict>
</plist>
