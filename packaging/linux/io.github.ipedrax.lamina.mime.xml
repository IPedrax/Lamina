<?xml version="1.0" encoding="UTF-8"?>
<!-- A Lamina project is JSON with the extension .lamina. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-lamina">
    <comment>Lamina project</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.lamina"/>
  </mime-type>
</mime-info>
